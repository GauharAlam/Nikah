rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function isApproved() { return signedIn() && request.auth.token.approved == true; }
    function isReviewer() { return signedIn() && request.auth.token.reviewer == true; }

    function under(d, field, max) {
      return !(field in d) || (d[field] is string && d[field].size() <= max);
    }

    // An allow-list, so a member can never write a field the server reads as
    // state. The full validator runs at submission.
    function validDraft(d) {
      return d.keys().hasOnly([
          'managedBy', 'fullName', 'gender', 'maritalStatus', 'marriageReadiness', 'homeCity', 'homeState',
          'homeCountry', 'workCity', 'workSameAsHome', 'dateOfBirth', 'caste', 'partnerCaste', 'height',
          'phoneCode', 'phoneNumber', 'phone', 'almaMaters', 'qualification', 'qualificationGraduate',
          'profession', 'incomeRange', 'company', 'photos', 'aboutMe', 'step', 'stepVersion', 'sect', 'children',
          'photoPrivacy', 'showCaste', 'allowFamilyShare', 'intentConfirmed', 'dataConsent', 'candidateConsent',
          'inviteCode', 'prayer', 'prayerFrequency', 'quranComfort', 'practices', 'extraPractices',
          'halalLifestyle', 'preferredLanguage', 'familyType', 'familyBackground', 'familyValues',
          'familyLocation', 'siblings', 'graduationYear', 'educationStatus', 'employmentStatus',
          'careerDescription', 'subjectName', 'subjectPhone', 'relationship', 'nearbyOptIn', 'allowContactRequests'
        ])
        && under(d, 'fullName', 80) && under(d, 'aboutMe', 1500) && under(d, 'company', 80)
        && under(d, 'familyBackground', 1000) && under(d, 'familyValues', 500)
        && under(d, 'careerDescription', 1000) && under(d, 'familyLocation', 120)
        && (!('photos' in d) || (d.photos is list && d.photos.size() <= 6))
        && (!('almaMaters' in d) || (d.almaMaters is list && d.almaMaters.size() <= 5));
    }

    // Limits and option lists.
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // The onboarding draft is the only member-written profile data. Nothing
    // here reaches other members until a reviewer approves it.
    match /drafts/{uid} {
      allow read: if isUser(uid) || isReviewer();
      allow create, update: if isUser(uid) && validDraft(request.resource.data);
      allow delete: if false;
    }

    // Stage, quotas, credits and entitlement. Server only.
    match /accounts/{uid} {
      allow read: if isUser(uid);
      allow write: if false;

      match /documents/{docType} {
        allow read: if isUser(uid);
        allow write: if false;
      }
      match /consents/{category} {
        allow read: if isUser(uid);
        allow write: if false;
      }
      match /notifications/{id} {
        allow read: if isUser(uid);
        allow update: if isUser(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
      match /devices/{token} {
        allow read, write: if isUser(uid);
      }
    }

    // Published cards are served by getProfiles / fetchIntroductions, which
    // apply block and gender rules. No direct reads, so nothing can be scraped.
    match /profiles/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    match /proposals/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }
    match /contactRequests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow write: if false;
    }
    match /contactShares/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow write: if false;
    }

    match /matches/{pair} {
      function participant() {
        return signedIn() && request.auth.uid in get(/databases/$(database)/documents/matches/$(pair)).data.users;
      }
      function open() {
        return get(/databases/$(database)/documents/matches/$(pair)).data.status == 'active';
      }
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      // A member may only move their own read marker and clear their own count.
      allow update: if signedIn() && request.auth.uid in resource.data.users && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt', 'unread'])
          && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.unread.diff(resource.data.unread).affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.unread == resource.data.unread || request.resource.data.unread[request.auth.uid] == 0))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['journey'])
          && request.resource.data.journey.diff(resource.data.get('journey', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.journey[request.auth.uid] in ['talking', 'questions', 'families', 'istikhara', 'decision'])
      );
      allow create, delete: if false;

      // Important Questions: you see the other answers only after giving yours.
      match /answers/{uid} {
        allow read: if participant() && (request.auth.uid == uid
          || exists(/databases/$(database)/documents/matches/$(pair)/answers/$(request.auth.uid)));
        allow create, update: if participant() && open() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['answers', 'updatedAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 40;
        allow delete: if false;
      }

      // Closing or blocking a match, or losing approval, ends access to it.
      match /messages/{id} {
        allow read: if participant() && open() && isApproved();
        allow create: if participant() && open() && isApproved()
          && request.resource.data.keys().hasOnly(['sender', 'text', 'sentAt'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }

    // Family: the owner sees everything in their circle. A guardian sees their
    // own membership, and shared summaries only with view_shortlist.
    match /family/{member} {
      function membership() {
        return get(/databases/$(database)/documents/family/$(member)/memberships/$(request.auth.uid));
      }
      function isGuardianOf() {
        return signedIn() && exists(/databases/$(database)/documents/family/$(member)/memberships/$(request.auth.uid));
      }
      function mayViewShortlist() {
        return isUser(member) || (isGuardianOf() && 'view_shortlist' in membership().data.permissions);
      }
      allow read: if isUser(member) || isGuardianOf();
      allow write: if false;
      match /shortlist/{profile} {
        allow read: if mayViewShortlist();
        allow write: if false;
      }
      match /memberships/{guardian} {
        allow read: if isUser(member) || isUser(guardian);
        allow write: if false;
      }
      match /invitations/{id} {
        allow read: if isUser(member);
        allow write: if false;
      }
      match /history/{id} {
        allow read: if isUser(member);
        allow write: if false;
      }
    }

    match /familyLinks/{guardian}/circles/{member} {
      allow read: if isUser(guardian);
      allow write: if false;
    }

    match /deletionRequests/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Reports, blocks, hidden profiles and everything else: server only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
