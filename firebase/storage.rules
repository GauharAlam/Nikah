rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function under10MB() { return request.resource.size < 10 * 1024 * 1024; }

    match /photos/{uid}/{file} {
      allow write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || (isImage() && under10MB()));
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.token.approved == true);
    }

    // Members upload; nobody reads directly. Reviewers get short-lived signed
    // URLs from getDocumentUrl.
    match /verification/{uid}/{docType}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && under10MB()
        && (isImage() || request.resource.contentType == 'application/pdf');
      allow read, update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
